pipeline {
  agent any
  parameters {
      choice(name: 'ENVIRONMENT', choices: ['staging', 'production'], description: 'Target')
  }
  stages {
      stage('Build') {
          steps { sh "echo Building"}
      }
      stage('Test') {
          parallel {
              stage('Unit') {
                  steps {
                      sh "echo Unit tests"
                  }
              }
              stage('Integration') {
                  steps {
                      sh "echo Integration tests"
                  }
              }
          }
      }
      stage('Approve') {
          steps { 
              input message: 'Deploy to  production?'
          }
      }
  }
}
