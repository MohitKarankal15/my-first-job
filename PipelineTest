pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/MohitKarankal15/my-first-job.git'
            }
        }

        stage('Build') {
            steps {
                sh 'echo Installing dependencies'
                sh 'echo Building application'
            }
        }

        stage('Parallel Tests') {
            parallel {

                stage('Unit Tests') {
                    steps {
                        sh 'echo Running unit tests'
                    }
                }

                stage('Lint') {
                    steps {
                        sh 'echo Running lint'
                    }
                }
            }
        }
    }

    post {
        always {
            deleteDir()
        }
    }
}
